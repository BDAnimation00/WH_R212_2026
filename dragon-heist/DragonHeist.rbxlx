      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- RÉGLAGES DU JEU
-- Tous les chiffres d'équilibrage sont ici : change une valeur, sauvegarde, c'est appliqué.
-- Les durées sont en secondes.

local Config = {}

-- Cycle jour / nuit
Config.DayDuration = 600 -- 10 minutes de jour
Config.NightDuration = 150 -- 2 min 30 de nuit

-- Vitesse d'éclosion (1 = temps réel : 1 seconde d'éclosion par seconde)
Config.HatchSpeed = {
	Offline = 1, -- joueur déconnecté : temps réel
	OnlineDay = 2, -- connecté, de jour : 2x plus vite
	OnlineNight = 10, -- connecté, la nuit : 10x plus vite
}

-- Œufs sauvages dans les nids
Config.EggRespawnInterval = 300 -- les nids se remplissent toutes les 5 minutes
Config.EggsPerNest = 6 -- nombre d'œufs par zone à chaque remplissage
Config.NightRareBoost = 3 -- la nuit, les œufs rares de chaque zone ont 3x plus de chances d'apparaître
Config.AnnounceRarityOrder = 7 -- annonce à tout le serveur à partir de cette rareté (7 = Cosmique)

-- Base
Config.StartIncubators = 3
Config.MaxIncubators = 6
Config.LockDuration = 60 -- la porte reste verrouillée 60 s
Config.LockCooldown = 30 -- puis 30 s avant de pouvoir la reverrouiller

-- Joueur
Config.BaseWalkSpeed = 16
Config.SpeedPerLevel = 1.5
Config.MaxSpeedLevel = 30
Config.CarrySpeedMultiplier = 0.75 -- porter un œuf ralentit
Config.StealHoldDuration = 2 -- temps à maintenir la touche pour voler

-- Économie
Config.StartGold = 0
Config.SellSeconds = 120 -- un dragon se revend pour 120 secondes de ses revenus

function Config.SpeedCost(level)
	return math.floor(25 * 1.55 ^ level)
end

-- count = nombre d'incubateurs déjà possédés
function Config.IncubatorCost(count)
	return math.floor(500 * 6 ^ (count - Config.StartIncubators))
end

-- Mutations tirées à l'éclosion (testées de la plus rare à la plus commune)
Config.Mutations = {
	{ Name = "Arc-en-ciel", Chance = 0.01, Multiplier = 3, Color = Color3.fromRGB(255, 120, 230) },
	{ Name = "Doré", Chance = 0.04, Multiplier = 2, Color = Color3.fromRGB(255, 205, 60) },
	{ Name = "Argenté", Chance = 0.06, Multiplier = 1.2, Color = Color3.fromRGB(205, 215, 230) },
}

-- Mutation spéciale qui n'existe que si l'œuf éclot la nuit
Config.NightMutation = { Name = "Lunaire", Chance = 0.05, Multiplier = 2.5, Color = Color3.fromRGB(120, 160, 255) }

function Config.GetMutation(name)
	if name == nil then
		return nil
	end
	if name == Config.NightMutation.Name then
		return Config.NightMutation
	end
	for _, mutation in Config.Mutations do
		if mutation.Name == name then
			return mutation
		end
	end
	return nil
end

-- Sauvegarde
Config.DataStoreName = "DragonHeist_v1"
Config.AutosaveInterval = 120

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Eggs</string>
          <string name="Source"><![CDATA[-- LISTE DES ŒUFS ET DES RARETÉS
-- Pour ajouter un œuf : copie une ligne de Eggs.List et change les valeurs.
--   Id         : identifiant unique (sert aussi de nom au modèle 3D dans ReplicatedStorage/Assets/Eggs et Assets/Dragons)
--   Zone       : 1 = Forêt, 2 = Volcan, 3 = Ciel
--   Weight     : chance relative d'apparaître dans sa zone
--   HatchTime  : temps d'éclosion en temps réel (secondes)
--   Income     : or rapporté par seconde par le dragon

local Eggs = {}

Eggs.Rarities = {
	Common = { Order = 1, Label = "Commun", Color = Color3.fromRGB(190, 190, 190) },
	Uncommon = { Order = 2, Label = "Peu commun", Color = Color3.fromRGB(90, 200, 90) },
	Rare = { Order = 3, Label = "Rare", Color = Color3.fromRGB(70, 140, 255) },
	Epic = { Order = 4, Label = "Épique", Color = Color3.fromRGB(170, 80, 255) },
	Legendary = { Order = 5, Label = "Légendaire", Color = Color3.fromRGB(255, 170, 30) },
	Mythic = { Order = 6, Label = "Mythique", Color = Color3.fromRGB(255, 60, 90) },
	Cosmic = { Order = 7, Label = "Cosmique", Color = Color3.fromRGB(60, 230, 230) },
	Secret = { Order = 8, Label = "Secret", Color = Color3.fromRGB(40, 40, 40) },
	Eternal = { Order = 9, Label = "Éternel", Color = Color3.fromRGB(255, 255, 255) },
}

Eggs.Zones = {
	[1] = "Forêt",
	[2] = "Volcan",
	[3] = "Ciel",
}

local MINUTE = 60
local HOUR = 3600

Eggs.List = {
	-- Forêt
	{ Id = "Ember", EggName = "Œuf de Braise", DragonName = "Dragonnet de Braise", Rarity = "Common", Zone = 1, Weight = 60, HatchTime = 10, Income = 1 },
	{ Id = "Moss", EggName = "Œuf de Mousse", DragonName = "Dragon Mousse", Rarity = "Uncommon", Zone = 1, Weight = 30, HatchTime = 1 * MINUTE, Income = 3 },
	{ Id = "Storm", EggName = "Œuf d'Orage", DragonName = "Dragon d'Orage", Rarity = "Rare", Zone = 1, Weight = 10, HatchTime = 5 * MINUTE, Income = 10 },
	-- Volcan
	{ Id = "Magma", EggName = "Œuf de Magma", DragonName = "Dragon de Magma", Rarity = "Rare", Zone = 2, Weight = 55, HatchTime = 6 * MINUTE, Income = 14 },
	{ Id = "Obsidian", EggName = "Œuf d'Obsidienne", DragonName = "Dragon d'Obsidienne", Rarity = "Epic", Zone = 2, Weight = 35, HatchTime = 20 * MINUTE, Income = 40 },
	{ Id = "Solar", EggName = "Œuf Solaire", DragonName = "Dragon Solaire", Rarity = "Legendary", Zone = 2, Weight = 10, HatchTime = 1 * HOUR, Income = 150 },
	-- Ciel
	{ Id = "Celestial", EggName = "Œuf Céleste", DragonName = "Dragon Céleste", Rarity = "Mythic", Zone = 3, Weight = 70, HatchTime = 3 * HOUR, Income = 500 },
	{ Id = "Nebula", EggName = "Œuf Nébuleuse", DragonName = "Dragon Nébuleuse", Rarity = "Cosmic", Zone = 3, Weight = 25, HatchTime = 6 * HOUR, Income = 1500 },
	{ Id = "Void", EggName = "Œuf du Néant", DragonName = "Dragon du Néant", Rarity = "Secret", Zone = 3, Weight = 4.5, HatchTime = 12 * HOUR, Income = 5000 },
	{ Id = "Primordial", EggName = "Œuf Primordial", DragonName = "Dragon Primordial", Rarity = "Eternal", Zone = 3, Weight = 0.5, HatchTime = 20 * HOUR, Income = 20000 },
}

Eggs.ById = {}
for _, egg in Eggs.List do
	Eggs.ById[egg.Id] = egg
end

function Eggs.GetRarity(eggId)
	local egg = Eggs.ById[eggId]
	return egg and Eggs.Rarities[egg.Rarity]
end

-- Tire un œuf au hasard dans une zone.
-- La nuit, tous les œufs de la zone sauf le plus commun sont boostés (x nightBoost).
function Eggs.Roll(zone, isNight, nightBoost, rng)
	local maxWeight = 0
	for _, egg in Eggs.List do
		if egg.Zone == zone then
			maxWeight = math.max(maxWeight, egg.Weight)
		end
	end

	local candidates = {}
	local total = 0
	for _, egg in Eggs.List do
		if egg.Zone == zone then
			local weight = egg.Weight
			if isNight and egg.Weight < maxWeight then
				weight *= nightBoost
			end
			total += weight
			table.insert(candidates, { Egg = egg, Weight = weight })
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, candidate in candidates do
		roll -= candidate.Weight
		if roll <= 0 then
			return candidate.Egg
		end
	end
	return candidates[#candidates].Egg
end

return Eggs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Mise en forme des nombres et des durées pour l'affichage.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

function Format.Number(n)
	n = math.floor(n)
	local value = n
	local index = 1
	while math.abs(value) >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end
	if index == 1 then
		return tostring(n)
	end
	return string.format("%.1f%s", value, SUFFIXES[index])
end

function Format.Time(seconds)
	seconds = math.max(0, math.ceil(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %02ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Canaux de communication serveur <-> joueurs. Le serveur les crée, les joueurs les attendent.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local NAMES = { "Notify", "HatchReveal", "UpgradeSpeed" }

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in NAMES do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local Remotes = {}
for _, name in NAMES do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
