        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Point d'entrée du serveur : démarre tous les systèmes et gère l'arrivée / le départ des joueurs.

local Players = game:GetService("Players")

local WorldBuilder = require(script.Parent.WorldBuilder)
if not workspace:FindFirstChild("Map") then
	WorldBuilder.Build().Parent = workspace
end

local Services = script.Parent.Services
local BaseService = require(Services.BaseService)
local CharacterService = require(Services.CharacterService)
local DataService = require(Services.DataService)
local DayNightService = require(Services.DayNightService)
local DragonService = require(Services.DragonService)
local EggSpawnService = require(Services.EggSpawnService)
local IncubatorService = require(Services.IncubatorService)
local ShopService = require(Services.ShopService)

DataService.Start()
DayNightService.Start()
BaseService.Start()
DragonService.Start()
IncubatorService.Start()
EggSpawnService.Start()
ShopService.Start()

local function onPlayerAdded(player)
	DataService.Load(player)
	if not player.Parent then
		DataService.Release(player)
		return
	end
	local base = BaseService.Assign(player)
	if not base then
		player:Kick("Serveur plein, réessaie sur un autre serveur !")
		return
	end
	DragonService.Setup(player, base)
	IncubatorService.Setup(player, base)
	CharacterService.Setup(player)
end

local function onPlayerRemoving(player)
	IncubatorService.Cleanup(player)
	DragonService.Cleanup(player)
	CharacterService.Cleanup(player)
	BaseService.Release(player)
	DataService.Release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[-- Bases des joueurs : attribution, panneau, porte verrouillable.
-- Porte verrouillée = mur pour les autres joueurs, mais le propriétaire passe à travers.

local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Visuals = require(script.Parent.Visuals)

local BaseService = {}

local bases = {} -- liste de { Model, Index, Owner, LockedUntil, CooldownUntil, LockPrompt }
local playerBase = {} -- [player] = base

local function doorGroup(base)
	return "Door" .. base.Index
end

local function ownerGroup(base)
	return "Owner" .. base.Index
end

local function registerGroup(name)
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end

local function setSign(base)
	local signPart = base.Model:FindFirstChild("Sign")
	local gui = signPart and signPart:FindFirstChildWhichIsA("BillboardGui")
	local label = gui and gui:FindFirstChildWhichIsA("TextLabel")
	if label then
		label.Text = if base.Owner then "Base de " .. base.Owner.DisplayName else "Base libre"
	end
end

function BaseService.IsLocked(base)
	return workspace:GetServerTimeNow() < base.LockedUntil
end

local function updateDoor(base)
	local door = base.Model:FindFirstChild("Door")
	if not door then
		return
	end
	local locked = BaseService.IsLocked(base)
	door.CanCollide = locked
	door.Transparency = if locked then 0.35 else 0.85
	door.Color = if locked then Color3.fromRGB(230, 60, 60) else Color3.fromRGB(80, 220, 120)
	base.Model:SetAttribute("Locked", locked)

	local label = door:FindFirstChild("InfoLabel") and door.InfoLabel:FindFirstChildWhichIsA("TextLabel")
	if label then
		if locked then
			label.Text = "🔒 " .. Format.Time(base.LockedUntil - workspace:GetServerTimeNow())
		elseif base.Owner then
			label.Text = "🔓 Ouvert"
		else
			label.Text = ""
		end
	end
end

local function onLockTriggered(base, player)
	if base.Owner ~= player then
		return
	end
	local now = workspace:GetServerTimeNow()
	if BaseService.IsLocked(base) then
		Remotes.Notify:FireClient(player, "🔒 Ta base est déjà verrouillée.")
		return
	end
	if now < base.CooldownUntil then
		Remotes.Notify:FireClient(player, "⏳ Verrou disponible dans " .. Format.Time(base.CooldownUntil - now))
		return
	end
	base.LockedUntil = now + Config.LockDuration
	base.CooldownUntil = base.LockedUntil + Config.LockCooldown
	updateDoor(base)
	Remotes.Notify:FireClient(player, "🔒 Base verrouillée pour " .. Format.Time(Config.LockDuration) .. " !")
end

function BaseService.Start()
	local folder = workspace:WaitForChild("Map"):WaitForChild("Bases")
	for _, model in folder:GetChildren() do
		local index = tonumber(string.match(model.Name, "%d+"))
		if index then
			table.insert(bases, { Model = model, Index = index, Owner = nil, LockedUntil = 0, CooldownUntil = 0 })
		end
	end
	table.sort(bases, function(a, b)
		return a.Index < b.Index
	end)

	for _, base in bases do
		registerGroup(doorGroup(base))
		registerGroup(ownerGroup(base))
		PhysicsService:CollisionGroupSetCollidable(doorGroup(base), ownerGroup(base), false)
		local door = base.Model:FindFirstChild("Door")
		if door then
			door.CollisionGroup = doorGroup(base)
			Visuals.Label(door, 8, 160)
		end
		setSign(base)
		updateDoor(base)
	end

	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, base in bases do
				updateDoor(base)
			end
		end
	end)
end

function BaseService.Assign(player)
	for _, base in bases do
		if not base.Owner then
			base.Owner = player
			base.LockedUntil = 0
			base.CooldownUntil = 0
			base.Model:SetAttribute("OwnerUserId", player.UserId)
			playerBase[player] = base

			local button = base.Model:FindFirstChild("LockButton")
			if button then
				base.LockPrompt = Visuals.Prompt(button, {
					Name = "LockPrompt",
					ActionText = "Verrouiller",
					ObjectText = "Porte",
					Audience = "Owner",
					OwnerUserId = player.UserId,
				})
				base.LockPrompt.Triggered:Connect(function(who)
					onLockTriggered(base, who)
				end)
			end
			setSign(base)
			updateDoor(base)
			return base
		end
	end
	return nil
end

function BaseService.Release(player)
	local base = playerBase[player]
	if not base then
		return
	end
	playerBase[player] = nil
	base.Owner = nil
	base.LockedUntil = 0
	base.Model:SetAttribute("OwnerUserId", nil)
	if base.LockPrompt then
		base.LockPrompt:Destroy()
		base.LockPrompt = nil
	end
	setSign(base)
	updateDoor(base)
end

function BaseService.GetBase(player)
	return playerBase[player]
end

function BaseService.GetSpawnCFrame(player)
	local base = playerBase[player]
	local spawnPart = base and base.Model:FindFirstChild("Spawn")
	if spawnPart then
		return spawnPart.CFrame * CFrame.new(0, 3, 0)
	end
	return nil
end

-- Le propriétaire passe à travers sa propre porte verrouillée
function BaseService.ApplyOwnerCollision(player, character)
	local base = playerBase[player]
	if not base then
		return
	end
	local group = ownerGroup(base)
	local function apply(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = group
		end
	end
	for _, descendant in character:GetDescendants() do
		apply(descendant)
	end
	character.DescendantAdded:Connect(apply)
end

return BaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[-- Personnage : vitesse de marche, œuf porté au-dessus de la tête, apparition dans sa base.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Eggs = require(ReplicatedStorage.Shared.Eggs)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local BaseService = require(script.Parent.BaseService)
local Visuals = require(script.Parent.Visuals)

local CharacterService = {}

local carrying = {} -- [player] = { EggId, Progress, Visual }

function CharacterService.GetWalkSpeed(player)
	local data = DataService.Get(player)
	local level = if data then data.SpeedLevel else 0
	local speed = Config.BaseWalkSpeed + level * Config.SpeedPerLevel
	if carrying[player] then
		speed *= Config.CarrySpeedMultiplier
	end
	return speed
end

function CharacterService.Refresh(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = CharacterService.GetWalkSpeed(player)
	end
end

function CharacterService.GetCarried(player)
	return carrying[player]
end

function CharacterService.StartCarry(player, eggId, progress)
	if carrying[player] then
		return false
	end
	local head = player.Character and player.Character:FindFirstChild("Head")
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local visual = Visuals.Egg(eggId, false)
	visual:PivotTo(head.CFrame * CFrame.new(0, 2.6, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = visual.PrimaryPart
	weld.Parent = visual.PrimaryPart
	visual.Parent = player.Character

	carrying[player] = { EggId = eggId, Progress = progress or 0, Visual = visual }
	player:SetAttribute("CarryingEgg", Eggs.ById[eggId].EggName)
	CharacterService.Refresh(player)
	return true
end

-- Retire l'œuf porté et le renvoie (ou nil)
function CharacterService.StopCarry(player)
	local carried = carrying[player]
	if not carried then
		return nil
	end
	carrying[player] = nil
	if carried.Visual then
		carried.Visual:Destroy()
	end
	player:SetAttribute("CarryingEgg", nil)
	CharacterService.Refresh(player)
	return carried
end

local function onCharacterAdded(player, character)
	carrying[player] = nil
	player:SetAttribute("CarryingEgg", nil)

	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")
	BaseService.ApplyOwnerCollision(player, character)
	CharacterService.Refresh(player)

	local spawnCFrame = BaseService.GetSpawnCFrame(player)
	if spawnCFrame then
		task.delay(0.1, function()
			if root.Parent then
				root.CFrame = spawnCFrame
			end
		end)
	end

	humanoid.Died:Connect(function()
		if CharacterService.StopCarry(player) then
			Remotes.Notify:FireClient(player, "💥 Tu as perdu l'œuf que tu portais !")
		end
	end)
end

function CharacterService.Setup(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

function CharacterService.Cleanup(player)
	CharacterService.StopCarry(player)
end

Players.PlayerRemoving:Connect(function(player)
	carrying[player] = nil
end)

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Sauvegarde et chargement de la progression des joueurs (DataStore).
-- Dans Studio : Paramètres du jeu > Sécurité > "Enable Studio Access to API Services" pour tester la sauvegarde.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Eggs = require(ReplicatedStorage.Shared.Eggs)
local Format = require(ReplicatedStorage.Shared.Format)

local DataService = {}

local profiles = {} -- [player] = { Data = table, CanSave = bool }

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponible :", result)
	end
end

local function defaultData()
	return {
		Gold = Config.StartGold,
		SpeedLevel = 0,
		IncubatorCount = Config.StartIncubators,
		Incubators = {}, -- ["1"] = { EggId = "Ember", Progress = 0 }
		Dragons = {}, -- { { EggId = "Ember", Mutation = "Doré" | nil } }
		LastOnline = os.time(),
	}
end

local function reconcile(data)
	for key, value in defaultData() do
		if data[key] == nil then
			data[key] = value
		end
	end
	-- Retire les œufs / dragons qui n'existent plus dans Eggs.luau
	for slot, entry in data.Incubators do
		if not Eggs.ById[entry.EggId] then
			data.Incubators[slot] = nil
		end
	end
	for i = #data.Dragons, 1, -1 do
		if not Eggs.ById[data.Dragons[i].EggId] then
			table.remove(data.Dragons, i)
		end
	end
	return data
end

-- Hors ligne, les œufs continuent d'éclore en temps réel
local function applyOfflineProgress(data)
	local elapsed = math.max(0, os.time() - (data.LastOnline or os.time()))
	for _, entry in data.Incubators do
		local egg = Eggs.ById[entry.EggId]
		entry.Progress = math.min(egg.HatchTime, entry.Progress + elapsed * Config.HatchSpeed.Offline)
	end
end

local function key(player)
	return "player_" .. player.UserId
end

function DataService.Load(player)
	local data = nil
	local canSave = false
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				data = result
				canSave = true
				break
			end
			warn(string.format("[DataService] Échec du chargement (%d/3) pour %s : %s", attempt, player.Name, tostring(result)))
			task.wait(1)
		end
	end
	if not canSave then
		warn("[DataService] Progression de " .. player.Name .. " NON sauvegardée cette session.")
	end

	data = reconcile(data or defaultData())
	applyOfflineProgress(data)

	local profile = { Data = data, CanSave = canSave }
	profiles[player] = profile
	DataService.Sync(player)
	return profile
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.Data
end

-- Met à jour les infos visibles (classement, interface)
function DataService.Sync(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	player:SetAttribute("Gold", data.Gold)
	player:SetAttribute("SpeedLevel", data.SpeedLevel)
	player:SetAttribute("IncubatorCount", data.IncubatorCount)

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		local gold = Instance.new("StringValue")
		gold.Name = "Or"
		gold.Parent = leaderstats
		leaderstats.Parent = player
	end
	leaderstats.Or.Value = Format.Number(data.Gold)
end

function DataService.AddGold(player, amount)
	local data = DataService.Get(player)
	if not data then
		return
	end
	data.Gold += amount
	DataService.Sync(player)
end

function DataService.SpendGold(player, amount)
	local data = DataService.Get(player)
	if not data or data.Gold < amount then
		return false
	end
	data.Gold -= amount
	DataService.Sync(player)
	return true
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return
	end
	profile.Data.LastOnline = os.time()
	local ok, err = pcall(function()
		store:SetAsync(key(player), profile.Data)
	end)
	if not ok then
		warn("[DataService] Échec de la sauvegarde pour " .. player.Name .. " : " .. tostring(err))
	end
end

function DataService.Release(player)
	DataService.Save(player)
	profiles[player] = nil
end

function DataService.Start()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				DataService.Save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DayNightService</string>
            <string name="Source"><![CDATA[-- Cycle jour / nuit. La nuit, les œufs éclosent beaucoup plus vite (voir Config.HatchSpeed).
-- L'état est publié dans les attributs de ReplicatedStorage pour l'interface des joueurs :
--   IsNight (bool), PhaseEndsAt (heure serveur de fin de la phase)

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local DayNightService = {}

local isNight = false

function DayNightService.IsNight()
	return isNight
end

function DayNightService.GetHatchRate()
	return if isNight then Config.HatchSpeed.OnlineNight else Config.HatchSpeed.OnlineDay
end

local function setPhase(night, duration)
	isNight = night
	ReplicatedStorage:SetAttribute("IsNight", night)
	ReplicatedStorage:SetAttribute("PhaseEndsAt", workspace:GetServerTimeNow() + duration)

	TweenService:Create(Lighting, TweenInfo.new(4), {
		ClockTime = if night then 21.5 else 13,
		Brightness = if night then 0.6 else 2,
	}):Play()

	if night then
		Remotes.Notify:FireAllClients(string.format(
			"🌙 La nuit tombe ! Éclosion x%d pendant %s !",
			Config.HatchSpeed.OnlineNight,
			Format.Time(duration)
		))
	else
		Remotes.Notify:FireAllClients("☀️ Le jour se lève.")
	end
end

function DayNightService.Start()
	task.spawn(function()
		while true do
			setPhase(false, Config.DayDuration)
			task.wait(Config.DayDuration)
			setPhase(true, Config.NightDuration)
			task.wait(Config.NightDuration)
		end
	end)
end

return DayNightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DragonService</string>
            <string name="Source"><![CDATA[-- Dragons éclos : affichage sur les socles de la base, revenus en or, revente.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Eggs = require(ReplicatedStorage.Shared.Eggs)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local Visuals = require(script.Parent.Visuals)

local DragonService = {}

local states = {} -- [player] = { Pads = { Part }, Visuals = { Model } }

local function sortedChildren(folder)
	local list = folder and folder:GetChildren() or {}
	table.sort(list, function(a, b)
		return (tonumber(string.match(a.Name, "%d+")) or 0) < (tonumber(string.match(b.Name, "%d+")) or 0)
	end)
	return list
end

function DragonService.GetIncome(dragon)
	local egg = Eggs.ById[dragon.EggId]
	local mutation = Config.GetMutation(dragon.Mutation)
	return egg.Income * (if mutation then mutation.Multiplier else 1)
end

function DragonService.GetSellPrice(dragon)
	return math.floor(DragonService.GetIncome(dragon) * Config.SellSeconds)
end

function DragonService.HasRoom(player)
	local state = states[player]
	local data = DataService.Get(player)
	return state ~= nil and data ~= nil and #data.Dragons < #state.Pads
end

local function sell(player, dragon)
	local data = DataService.Get(player)
	local index = data and table.find(data.Dragons, dragon)
	if not index then
		return
	end
	table.remove(data.Dragons, index)
	local price = DragonService.GetSellPrice(dragon)
	DataService.AddGold(player, price)
	Remotes.Notify:FireClient(player, "💰 Dragon vendu pour " .. Format.Number(price) .. " or")
	DragonService.Render(player)
end

function DragonService.Render(player)
	local state = states[player]
	local data = DataService.Get(player)
	if not state or not data then
		return
	end
	for _, visual in state.Visuals do
		visual:Destroy()
	end
	table.clear(state.Visuals)

	local totalIncome = 0
	for i, dragon in data.Dragons do
		local pad = state.Pads[i]
		if not pad then
			break
		end
		local egg = Eggs.ById[dragon.EggId]
		local rarity = Eggs.Rarities[egg.Rarity]
		local mutation = Config.GetMutation(dragon.Mutation)
		local income = DragonService.GetIncome(dragon)
		totalIncome += income

		local visual = Visuals.Dragon(dragon.EggId, dragon.Mutation)
		local _, size = visual:GetBoundingBox()
		visual:PivotTo(pad.CFrame * CFrame.new(0, pad.Size.Y / 2 + size.Y / 2, 0))
		visual.Parent = pad

		local title = Visuals.Colorize(egg.DragonName, rarity.Color)
		if mutation then
			title = Visuals.Colorize(mutation.Name, mutation.Color) .. " " .. title
		end
		local label = Visuals.Label(visual.PrimaryPart, size.Y / 2 + 2, 180)
		label.Text = title .. "\n💰 " .. Format.Number(income) .. "/s"

		local prompt = Visuals.Prompt(visual.PrimaryPart, {
			Name = "SellPrompt",
			ActionText = "Vendre (" .. Format.Number(DragonService.GetSellPrice(dragon)) .. " or)",
			ObjectText = egg.DragonName,
			HoldDuration = 1,
			Audience = "Owner",
			OwnerUserId = player.UserId,
		})
		prompt.Triggered:Connect(function(who)
			if who == player then
				sell(player, dragon)
			end
		end)
		table.insert(state.Visuals, visual)
	end
	player:SetAttribute("IncomePerSecond", totalIncome)
end

function DragonService.Add(player, eggId, mutationName)
	local data = DataService.Get(player)
	if not data then
		return
	end
	table.insert(data.Dragons, { EggId = eggId, Mutation = mutationName })
	DragonService.Render(player)
end

function DragonService.Setup(player, base)
	states[player] = {
		Pads = sortedChildren(base.Model:FindFirstChild("DragonPads")),
		Visuals = {},
	}
	DragonService.Render(player)
end

function DragonService.Cleanup(player)
	local state = states[player]
	if state then
		for _, visual in state.Visuals do
			visual:Destroy()
		end
	end
	states[player] = nil
end

function DragonService.Start()
	-- Revenus : seuls les dragons posés sur un socle rapportent, uniquement quand le joueur est connecté
	task.spawn(function()
		while true do
			task.wait(1)
			for player in states do
				local income = player:GetAttribute("IncomePerSecond") or 0
				if income > 0 then
					DataService.AddGold(player, income)
				end
			end
		end
	end)
end

return DragonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">EggSpawnService</string>
            <string name="Source"><![CDATA[-- Nids : toutes les 5 minutes, chaque zone se remplit de nouveaux œufs (pour tout le serveur).
-- La nuit, les œufs rares apparaissent plus souvent. Les œufs très rares sont annoncés à tout le monde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Eggs = require(ReplicatedStorage.Shared.Eggs)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CharacterService = require(script.Parent.CharacterService)
local DayNightService = require(script.Parent.DayNightService)
local Visuals = require(script.Parent.Visuals)

local EggSpawnService = {}

local rng = Random.new()
local container

local function randomPointOn(zonePart)
	local size = zonePart.Size
	local x = (rng:NextNumber() - 0.5) * size.X * 0.9
	local z = (rng:NextNumber() - 0.5) * size.Z * 0.9
	return zonePart.CFrame * CFrame.new(x, size.Y / 2 + 1.4, z)
end

local function spawnEgg(zonePart, egg)
	local visual = Visuals.Egg(egg.Id, true)
	local cf = randomPointOn(zonePart)
	visual:PivotTo(CFrame.new(cf.Position))
	visual.Parent = container

	local rarity = Eggs.Rarities[egg.Rarity]
	local label = Visuals.Label(visual.PrimaryPart, 3, 160)
	label.Text = Visuals.Colorize(egg.EggName, rarity.Color) .. "\n" .. Visuals.Colorize(rarity.Label, rarity.Color)
	label.Parent.MaxDistance = 60

	local prompt = Visuals.Prompt(visual.PrimaryPart, {
		Name = "TakePrompt",
		ActionText = "Prendre",
		ObjectText = egg.EggName,
		HoldDuration = 0.3,
		Audience = "All",
	})
	prompt.Triggered:Connect(function(player)
		if not visual.Parent then
			return
		end
		if CharacterService.GetCarried(player) then
			Remotes.Notify:FireClient(player, "🥚 Tu portes déjà un œuf ! Pose-le dans un incubateur.")
			return
		end
		if CharacterService.StartCarry(player, egg.Id, 0) then
			visual:Destroy()
		end
	end)
end

local function refill()
	container:ClearAllChildren()
	local isNight = DayNightService.IsNight()
	local zones = workspace.Map:FindFirstChild("NestZones")
	if not zones then
		warn("[EggSpawnService] Aucun dossier Map/NestZones")
		return
	end
	for _, zonePart in zones:GetChildren() do
		local zone = zonePart:GetAttribute("Zone")
		if zonePart:IsA("BasePart") and zone then
			for _ = 1, Config.EggsPerNest do
				local egg = Eggs.Roll(zone, isNight, Config.NightRareBoost, rng)
				if egg then
					spawnEgg(zonePart, egg)
					local rarity = Eggs.Rarities[egg.Rarity]
					if rarity.Order >= Config.AnnounceRarityOrder then
						Remotes.Notify:FireAllClients(string.format(
							"📢 Un œuf %s est apparu : %s (%s) !",
							string.upper(rarity.Label),
							egg.EggName,
							Eggs.Zones[zone] or "?"
						))
					end
				end
			end
		end
	end
	Remotes.Notify:FireAllClients("🥚 Les nids se sont remplis !")
end

function EggSpawnService.Start()
	container = Instance.new("Folder")
	container.Name = "WildEggs"
	container.Parent = workspace

	task.spawn(function()
		while true do
			refill()
			ReplicatedStorage:SetAttribute("EggRespawnAt", workspace:GetServerTimeNow() + Config.EggRespawnInterval)
			task.wait(Config.EggRespawnInterval)
		end
	end)
end

return EggSpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">IncubatorService</string>
            <string name="Source"><![CDATA[-- Incubateurs : poser un œuf, éclosion en temps réel (accélérée si connecté, x10 la nuit),
-- faire éclore (tirage des mutations), vol par les autres joueurs, achat d'incubateurs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Eggs = require(ReplicatedStorage.Shared.Eggs)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local BaseService = require(script.Parent.BaseService)
local CharacterService = require(script.Parent.CharacterService)
local DataService = require(script.Parent.DataService)
local DayNightService = require(script.Parent.DayNightService)
local DragonService = require(script.Parent.DragonService)
local Visuals = require(script.Parent.Visuals)

local IncubatorService = {}

local states = {} -- [player] = { Base, Slots = { [i] = slot } }
local rng = Random.new()

local function sortedChildren(folder)
	local list = folder and folder:GetChildren() or {}
	table.sort(list, function(a, b)
		return (tonumber(string.match(a.Name, "%d+")) or 0) < (tonumber(string.match(b.Name, "%d+")) or 0)
	end)
	return list
end

local function setActive(prompt, active)
	prompt:SetAttribute("Active", active)
end

local function rollMutation(isNight)
	if isNight and rng:NextNumber() < Config.NightMutation.Chance then
		return Config.NightMutation.Name
	end
	local roll = rng:NextNumber()
	for _, mutation in Config.Mutations do
		if roll < mutation.Chance then
			return mutation.Name
		end
		roll -= mutation.Chance
	end
	return nil
end

local function updateLabel(player, index)
	local state = states[player]
	local data = DataService.Get(player)
	local slot = state and state.Slots[index]
	if not slot or not data then
		return
	end

	if index > data.IncubatorCount then
		if index == data.IncubatorCount + 1 then
			slot.Label.Text = "🔒 Incubateur\n💰 " .. Format.Number(Config.IncubatorCost(data.IncubatorCount))
		else
			slot.Label.Text = "🔒"
		end
		return
	end

	local entry = data.Incubators[tostring(index)]
	if not entry then
		slot.Label.Text = "Vide\n<font size=\"14\">Pose un œuf ici</font>"
		return
	end

	local egg = Eggs.ById[entry.EggId]
	local rarity = Eggs.Rarities[egg.Rarity]
	local title = Visuals.Colorize(egg.EggName, rarity.Color)
	if entry.Progress >= egg.HatchTime then
		slot.Label.Text = title .. "\n✨ PRÊT À ÉCLORE !"
	else
		local rate = DayNightService.GetHatchRate()
		local remaining = (egg.HatchTime - entry.Progress) / rate
		local speed = if DayNightService.IsNight() then " 🌙x" .. rate else ""
		slot.Label.Text = title .. "\n⏳ " .. Format.Time(remaining) .. speed
	end
end

function IncubatorService.Render(player, index)
	local state = states[player]
	local data = DataService.Get(player)
	local slot = state and state.Slots[index]
	if not slot or not data then
		return
	end

	local owned = index <= data.IncubatorCount
	local entry = owned and data.Incubators[tostring(index)] or nil
	local eggId = entry and entry.EggId or nil

	slot.Part.Transparency = if owned then 0 else 0.6

	-- Visuel de l'œuf posé
	if slot.VisualEggId ~= eggId then
		if slot.Visual then
			slot.Visual:Destroy()
			slot.Visual = nil
		end
		if eggId then
			local visual = Visuals.Egg(eggId, true)
			visual:PivotTo(slot.Part.CFrame * CFrame.Angles(0, 0, math.rad(-90)) * CFrame.new(0, 2.2, 0))
			visual.Parent = slot.Part
			slot.Visual = visual
		end
		slot.VisualEggId = eggId
	end

	local ready = entry ~= nil and entry.Progress >= Eggs.ById[entry.EggId].HatchTime
	setActive(slot.BuyPrompt, index == data.IncubatorCount + 1 and index <= Config.MaxIncubators)
	slot.BuyPrompt.ActionText = "Acheter (" .. Format.Number(Config.IncubatorCost(data.IncubatorCount)) .. " or)"
	setActive(slot.PlacePrompt, owned and entry == nil)
	setActive(slot.HatchPrompt, ready)
	setActive(slot.StealPrompt, entry ~= nil)
	slot.StealPrompt.ObjectText = if entry then Eggs.ById[entry.EggId].EggName else ""
	updateLabel(player, index)
end

local function renderAll(player)
	local state = states[player]
	if state then
		for index in state.Slots do
			IncubatorService.Render(player, index)
		end
	end
end

local function onPlace(owner, index, who)
	if who ~= owner then
		return
	end
	local data = DataService.Get(owner)
	if not data or index > data.IncubatorCount or data.Incubators[tostring(index)] then
		return
	end
	local carried = CharacterService.GetCarried(owner)
	if not carried then
		Remotes.Notify:FireClient(owner, "🥚 Va chercher un œuf dans les nids d'abord !")
		return
	end
	CharacterService.StopCarry(owner)
	data.Incubators[tostring(index)] = { EggId = carried.EggId, Progress = carried.Progress }
	IncubatorService.Render(owner, index)
end

local function onHatch(owner, index, who)
	if who ~= owner then
		return
	end
	local data = DataService.Get(owner)
	local entry = data and data.Incubators[tostring(index)]
	if not entry then
		return
	end
	local egg = Eggs.ById[entry.EggId]
	if entry.Progress < egg.HatchTime then
		return
	end
	if not DragonService.HasRoom(owner) then
		Remotes.Notify:FireClient(owner, "🐉 Plus de place sur tes socles : vends un dragon d'abord !")
		return
	end
	data.Incubators[tostring(index)] = nil
	local mutation = rollMutation(DayNightService.IsNight())
	DragonService.Add(owner, egg.Id, mutation)
	Remotes.HatchReveal:FireClient(owner, egg.Id, mutation)
	IncubatorService.Render(owner, index)
end

local function onSteal(owner, index, thief)
	if thief == owner or not BaseService.GetBase(thief) then
		return
	end
	local base = states[owner] and states[owner].Base
	if not base or BaseService.IsLocked(base) then
		Remotes.Notify:FireClient(thief, "🔒 Cette base est verrouillée !")
		return
	end
	if CharacterService.GetCarried(thief) then
		Remotes.Notify:FireClient(thief, "🥚 Tu portes déjà un œuf !")
		return
	end
	local data = DataService.Get(owner)
	local entry = data and data.Incubators[tostring(index)]
	if not entry then
		return
	end
	if not CharacterService.StartCarry(thief, entry.EggId, entry.Progress) then
		return
	end
	data.Incubators[tostring(index)] = nil
	IncubatorService.Render(owner, index)

	local eggName = Eggs.ById[entry.EggId].EggName
	Remotes.Notify:FireClient(owner, "🚨 " .. thief.DisplayName .. " t'a volé ton " .. eggName .. " !")
	Remotes.Notify:FireClient(thief, "😈 Tu as volé un " .. eggName .. " ! Ramène-le vite à ta base !")
end

local function onBuy(owner, index, who)
	if who ~= owner then
		return
	end
	local data = DataService.Get(owner)
	if not data or index ~= data.IncubatorCount + 1 or index > Config.MaxIncubators then
		return
	end
	local cost = Config.IncubatorCost(data.IncubatorCount)
	if not DataService.SpendGold(owner, cost) then
		Remotes.Notify:FireClient(owner, "💰 Il te faut " .. Format.Number(cost) .. " or.")
		return
	end
	data.IncubatorCount += 1
	DataService.Sync(owner)
	Remotes.Notify:FireClient(owner, "✅ Nouvel incubateur débloqué !")
	renderAll(owner)
end

function IncubatorService.Setup(player, base)
	local state = { Base = base, Slots = {} }
	states[player] = state

	local parts = sortedChildren(base.Model:FindFirstChild("Incubators"))
	for index, part in parts do
		if index > Config.MaxIncubators then
			break
		end
		local userId = player.UserId
		local slot = { Part = part }
		slot.Label = Visuals.Label(part, 5, 200)
		slot.PlacePrompt = Visuals.Prompt(part, { Name = "PlacePrompt", ActionText = "Poser l'œuf", Audience = "Owner", OwnerUserId = userId })
		slot.HatchPrompt = Visuals.Prompt(part, { Name = "HatchPrompt", ActionText = "Faire éclore !", Audience = "Owner", OwnerUserId = userId, Key = Enum.KeyCode.F })
		slot.StealPrompt = Visuals.Prompt(part, {
			Name = "StealPrompt",
			ActionText = "Voler",
			HoldDuration = Config.StealHoldDuration,
			Audience = "Others",
			OwnerUserId = userId,
		})
		slot.BuyPrompt = Visuals.Prompt(part, { Name = "BuyPrompt", ActionText = "Acheter", ObjectText = "Incubateur", Audience = "Owner", OwnerUserId = userId })

		slot.PlacePrompt.Triggered:Connect(function(who)
			onPlace(player, index, who)
		end)
		slot.HatchPrompt.Triggered:Connect(function(who)
			onHatch(player, index, who)
		end)
		slot.StealPrompt.Triggered:Connect(function(who)
			onSteal(player, index, who)
		end)
		slot.BuyPrompt.Triggered:Connect(function(who)
			onBuy(player, index, who)
		end)
		state.Slots[index] = slot
	end
	renderAll(player)
end

function IncubatorService.Cleanup(player)
	local state = states[player]
	if not state then
		return
	end
	for _, slot in state.Slots do
		slot.Part.Transparency = 0
		if slot.Visual then
			slot.Visual:Destroy()
		end
		slot.Label.Parent:Destroy()
		for _, prompt in { slot.PlacePrompt, slot.HatchPrompt, slot.StealPrompt, slot.BuyPrompt } do
			prompt:Destroy()
		end
	end
	states[player] = nil
end

function IncubatorService.Start()
	-- Éclosion : chaque seconde, les œufs des joueurs connectés avancent (x2 de jour, x10 la nuit par défaut)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local now = os.clock()
			local dt = now - last
			last = now
			local rate = DayNightService.GetHatchRate()
			for player, state in states do
				local data = DataService.Get(player)
				if data then
					for key, entry in data.Incubators do
						local egg = Eggs.ById[entry.EggId]
						if entry.Progress < egg.HatchTime then
							entry.Progress = math.min(egg.HatchTime, entry.Progress + dt * rate)
							if entry.Progress >= egg.HatchTime then
								Remotes.Notify:FireClient(player, "✨ Ton " .. egg.EggName .. " est prêt à éclore !")
								IncubatorService.Render(player, tonumber(key))
							end
						end
					end
					for index in state.Slots do
						updateLabel(player, index)
					end
				end
			end
		end
	end)
end

return IncubatorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Boutique : amélioration de vitesse (payée en or).
-- Plus tard : game passes et produits Robux (vitesse x2, chance, œufs premium...).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CharacterService = require(script.Parent.CharacterService)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local lastRequest = {}

local function onUpgradeSpeed(player)
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 0.2 then
		return
	end
	lastRequest[player] = now

	local data = DataService.Get(player)
	if not data then
		return
	end
	if data.SpeedLevel >= Config.MaxSpeedLevel then
		Remotes.Notify:FireClient(player, "⚡ Vitesse au maximum !")
		return
	end
	local cost = Config.SpeedCost(data.SpeedLevel)
	if not DataService.SpendGold(player, cost) then
		Remotes.Notify:FireClient(player, "💰 Il te faut " .. Format.Number(cost) .. " or.")
		return
	end
	data.SpeedLevel += 1
	DataService.Sync(player)
	CharacterService.Refresh(player)
end

function ShopService.Start()
	Remotes.UpgradeSpeed.OnServerEvent:Connect(onUpgradeSpeed)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Visuals</string>
            <string name="Source"><![CDATA[-- Création des visuels : œufs, dragons, étiquettes et prompts d'interaction.
-- Si tu mets un modèle dans ReplicatedStorage/Assets/Eggs/<Id> ou Assets/Dragons/<Id>,
-- il remplace automatiquement le placeholder (cube / sphère).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Eggs = require(ReplicatedStorage.Shared.Eggs)

local Visuals = {}

local function findAsset(kind, id)
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild(kind)
	local asset = folder and folder:FindFirstChild(id)
	if asset and asset:IsA("Model") then
		return asset:Clone()
	end
	return nil
end

-- Rend un modèle déplaçable d'un bloc : tout est soudé à la PrimaryPart, rien ne bloque les joueurs.
local function prepare(model, anchored)
	if not model.PrimaryPart then
		model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart", true)
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = anchored
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.Massless = true
			if descendant ~= model.PrimaryPart then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = model.PrimaryPart
				weld.Part1 = descendant
				weld.Parent = descendant
			end
		end
	end
	return model
end

function Visuals.Egg(eggId, anchored)
	local model = findAsset("Eggs", eggId)
	if not model then
		local rarity = Eggs.GetRarity(eggId)
		model = Instance.new("Model")
		local shell = Instance.new("Part")
		shell.Name = "Shell"
		shell.Size = Vector3.new(2, 2.6, 2)
		shell.Color = rarity.Color
		shell.Material = if rarity.Order >= 5 then Enum.Material.Neon else Enum.Material.SmoothPlastic
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = shell
		shell.Parent = model
		model.PrimaryPart = shell
	end
	model.Name = "Egg_" .. eggId
	return prepare(model, anchored)
end

function Visuals.Dragon(eggId, mutationName)
	local mutation = Config.GetMutation(mutationName)
	local model = findAsset("Dragons", eggId)
	if model then
		if mutation then
			local highlight = Instance.new("Highlight")
			highlight.FillColor = mutation.Color
			highlight.FillTransparency = 0.6
			highlight.OutlineColor = mutation.Color
			highlight.Parent = model
		end
	else
		local rarity = Eggs.GetRarity(eggId)
		local color = if mutation then mutation.Color else rarity.Color
		model = Instance.new("Model")
		local body = Instance.new("Part")
		body.Name = "Body"
		body.Size = Vector3.new(3, 2.5, 4)
		body.Color = color
		body.Parent = model
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(2, 2, 2)
		head.Color = color
		head.CFrame = body.CFrame * CFrame.new(0, 1.5, -2.2)
		head.Parent = model
		local wing = Instance.new("Part")
		wing.Name = "Wings"
		wing.Size = Vector3.new(7, 0.3, 2)
		wing.Color = color:Lerp(Color3.new(0, 0, 0), 0.25)
		wing.CFrame = body.CFrame * CFrame.new(0, 1.4, 0.5)
		wing.Parent = model
		model.PrimaryPart = body
	end
	model.Name = "Dragon_" .. eggId
	return prepare(model, true)
end

-- Étiquette flottante (texte enrichi : <font color="#ff0000">...</font> possible)
function Visuals.Label(adornee, offsetY, width)
	local gui = Instance.new("BillboardGui")
	gui.Name = "InfoLabel"
	gui.Size = UDim2.new(0, width or 200, 0, 70)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Adornee = adornee
	gui.Parent = adornee
	return label
end

-- Prompt d'interaction.
-- audience = "All" (tout le monde), "Owner" (propriétaire de la base) ou "Others" (les autres joueurs).
-- L'affichage est filtré côté joueur ; le serveur revérifie toujours tout.
function Visuals.Prompt(parent, options)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = options.Name or "Prompt"
	prompt.ActionText = options.ActionText or ""
	prompt.ObjectText = options.ObjectText or ""
	prompt.HoldDuration = options.HoldDuration or 0
	prompt.MaxActivationDistance = options.Distance or 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = options.Key or Enum.KeyCode.E
	prompt:SetAttribute("Audience", options.Audience or "All")
	prompt:SetAttribute("OwnerUserId", options.OwnerUserId or 0)
	prompt:SetAttribute("Active", options.Active ~= false)
	CollectionService:AddTag(prompt, "DHPrompt")
	prompt.Parent = parent
	return prompt
end

function Visuals.Colorize(text, color)
	return string.format('<font color="#%s">%s</font>', color:ToHex(), text)
end

return Visuals
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- MAP DE BASE (placeholder)
-- Construit la carte de départ : 8 bases + 3 zones de nids (Forêt, Volcan, Ciel).
-- Le fichier DragonHeist.rbxlx contient déjà cette map : tu peux la modifier librement dans Studio.
-- Ce script ne la reconstruit QUE si workspace.Map n'existe pas.
--
-- Noms importants à garder si tu remplaces les pièces par tes modèles :
--   Map/Bases/Base_1..8   : Floor, Door, LockButton, Spawn, Sign,
--                           Incubators/Incubator_1..6, DragonPads/Pad_1..8
--   Map/NestZones/*       : pièces avec l'attribut "Zone" (1, 2 ou 3) ; les œufs apparaissent dessus

local WorldBuilder = {}

local BASE_COUNT = 8
local INCUBATORS = 6
local PADS = 8

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	return p
end

local function sign(parent, text, offsetY, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.new(0, 260, 0, 60)
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 400
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = text
	label.Parent = gui
	gui.Parent = parent
	return gui
end

local function buildBase(index, cf)
	local model = Instance.new("Model")
	model.Name = "Base_" .. index

	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end

	local floor = part({
		Name = "Floor",
		Size = Vector3.new(44, 1, 44),
		CFrame = at(0, 0.5, 0),
		Color = Color3.fromRGB(120, 105, 90),
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	model.PrimaryPart = floor

	local wallColor = Color3.fromRGB(150, 140, 125)
	part({ Name = "WallBack", Size = Vector3.new(44, 12, 1), CFrame = at(0, 7, 22), Color = wallColor, Material = Enum.Material.Brick, Parent = model })
	part({ Name = "WallLeft", Size = Vector3.new(1, 12, 44), CFrame = at(-22, 7, 0), Color = wallColor, Material = Enum.Material.Brick, Parent = model })
	part({ Name = "WallRight", Size = Vector3.new(1, 12, 44), CFrame = at(22, 7, 0), Color = wallColor, Material = Enum.Material.Brick, Parent = model })

	-- Porte (avant de la base, face au centre de la map). Transparente quand elle est ouverte.
	part({
		Name = "Door",
		Size = Vector3.new(42, 12, 1),
		CFrame = at(0, 7, -22),
		Color = Color3.fromRGB(80, 220, 120),
		Material = Enum.Material.ForceField,
		Transparency = 0.85,
		CanCollide = false,
		Parent = model,
	})

	part({
		Name = "LockButton",
		Size = Vector3.new(3, 2, 3),
		CFrame = at(17, 2, -17),
		Color = Color3.fromRGB(230, 60, 60),
		Material = Enum.Material.Neon,
		Parent = model,
	})

	part({
		Name = "Spawn",
		Size = Vector3.new(6, 0.2, 6),
		CFrame = at(0, 1.1, 6),
		Color = Color3.fromRGB(255, 255, 255),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.5,
		CanCollide = false,
		Parent = model,
	})

	local signPart = part({
		Name = "Sign",
		Size = Vector3.new(1, 1, 1),
		CFrame = at(0, 16, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = model,
	})
	sign(signPart, "Base libre", 0, Color3.fromRGB(255, 255, 255))

	local incubators = Instance.new("Folder")
	incubators.Name = "Incubators"
	incubators.Parent = model
	for i = 1, INCUBATORS do
		part({
			Name = "Incubator_" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.5, 5, 5),
			CFrame = at(-15 + (i - 1) * 6, 1.75, -8) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(240, 190, 90),
			Material = Enum.Material.SmoothPlastic,
			Parent = incubators,
		})
	end

	local pads = Instance.new("Folder")
	pads.Name = "DragonPads"
	pads.Parent = model
	for i = 1, PADS do
		part({
			Name = "Pad_" .. i,
			Size = Vector3.new(4.5, 0.4, 4.5),
			CFrame = at(-17.5 + (i - 1) * 5, 1.2, 15),
			Color = Color3.fromRGB(90, 90, 110),
			Material = Enum.Material.Slate,
			Parent = pads,
		})
	end

	return model
end

local function tree(parent, position)
	part({
		Name = "Trunk",
		Size = Vector3.new(2, 10, 2),
		CFrame = CFrame.new(position + Vector3.new(0, 5, 0)),
		Color = Color3.fromRGB(105, 70, 40),
		Material = Enum.Material.Wood,
		Parent = parent,
	})
	part({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(9, 9, 9),
		CFrame = CFrame.new(position + Vector3.new(0, 12, 0)),
		Color = Color3.fromRGB(60, 140, 60),
		Material = Enum.Material.Grass,
		Parent = parent,
	})
end

function WorldBuilder.Build()
	local map = Instance.new("Folder")
	map.Name = "Map"

	part({
		Name = "Ground",
		Size = Vector3.new(500, 2, 800),
		CFrame = CFrame.new(0, -1, -220),
		Color = Color3.fromRGB(110, 170, 90),
		Material = Enum.Material.Grass,
		Parent = map,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(0, 0.5, 90)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = map

	-- Bases : 4 à gauche, 4 à droite, portes tournées vers le centre
	local bases = Instance.new("Folder")
	bases.Name = "Bases"
	bases.Parent = map
	local rowsZ = { 60, 0, -60, -120 }
	for i = 1, BASE_COUNT do
		local side = if i <= 4 then -1 else 1
		local z = rowsZ[(i - 1) % 4 + 1]
		local position = Vector3.new(110 * side, 0, z)
		-- La porte est à l'avant (-Z local), on oriente donc l'avant vers le centre (x = 0)
		local cf = CFrame.lookAt(position, position + Vector3.new(-side, 0, 0))
		buildBase(i, cf).Parent = bases
	end

	-- Zones de nids : plus c'est loin, plus c'est rare
	local zones = Instance.new("Folder")
	zones.Name = "NestZones"
	zones.Parent = map

	local forest = part({
		Name = "Foret",
		Size = Vector3.new(120, 0.2, 200),
		CFrame = CFrame.new(0, 0.1, -30),
		Color = Color3.fromRGB(70, 130, 60),
		Material = Enum.Material.LeafyGrass,
		Parent = zones,
	})
	forest:SetAttribute("Zone", 1)
	sign(forest, "🌲 FORÊT", 14, Color3.fromRGB(150, 255, 150))

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map
	for _, offset in { Vector3.new(-50, 0, 40), Vector3.new(50, 0, 10), Vector3.new(-45, 0, -90), Vector3.new(48, 0, -110) } do
		tree(decor, Vector3.new(offset.X, 0.2, offset.Z))
	end

	local volcano = part({
		Name = "Volcan",
		Size = Vector3.new(140, 0.2, 140),
		CFrame = CFrame.new(0, 0.1, -300),
		Color = Color3.fromRGB(70, 40, 35),
		Material = Enum.Material.CrackedLava,
		Parent = zones,
	})
	volcano:SetAttribute("Zone", 2)
	sign(volcano, "🌋 VOLCAN", 14, Color3.fromRGB(255, 140, 60))

	-- Rampe vers le Ciel : monte de y=0 (z=-375) à y=40 (z=-465)
	local rise, run = 40, 90
	part({
		Name = "SkyRamp",
		Size = Vector3.new(20, 1, math.sqrt(rise * rise + run * run)),
		CFrame = CFrame.new(0, rise / 2, -375 - run / 2) * CFrame.Angles(math.atan2(rise, run), 0, 0),
		Color = Color3.fromRGB(230, 230, 255),
		Material = Enum.Material.Marble,
		Parent = map,
	})

	local sky = part({
		Name = "Ciel",
		Size = Vector3.new(130, 1, 130),
		CFrame = CFrame.new(0, 40, -530),
		Color = Color3.fromRGB(235, 245, 255),
		Material = Enum.Material.Glacier,
		Parent = zones,
	})
	sky:SetAttribute("Zone", 3)
	sign(sky, "☁️ CIEL", 14, Color3.fromRGB(150, 230, 255))

	return map
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Interface du joueur : jour/nuit, prochain remplissage des nids, or, vitesse, notifications, éclosion.
-- Le style (couleurs, polices, tailles) se change dans la section STYLE.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Eggs = require(Shared.Eggs)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer

-- STYLE
local FONT = Enum.Font.FredokaOne
local PANEL_COLOR = Color3.fromRGB(25, 25, 35)
local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
local GOLD_COLOR = Color3.fromRGB(255, 205, 60)
local NIGHT_COLOR = Color3.fromRGB(120, 160, 255)
local DAY_COLOR = Color3.fromRGB(255, 220, 120)

local gui = Instance.new("ScreenGui")
gui.Name = "DragonHeistHUD"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function round(instance, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 12)
	corner.Parent = instance
end

local function label(props)
	local l = Instance.new("TextLabel")
	l.BackgroundColor3 = PANEL_COLOR
	l.BackgroundTransparency = 0.25
	l.Font = FONT
	l.TextColor3 = TEXT_COLOR
	l.TextScaled = true
	l.RichText = true
	for key, value in props do
		l[key] = value
	end
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = l
	round(l)
	l.Parent = props.Parent or gui
	return l
end

-- Haut de l'écran : jour / nuit + nids
local phaseLabel = label({
	Name = "Phase",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0, 360, 0, 40),
})
local nestLabel = label({
	Name = "Nests",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 52),
	Size = UDim2.new(0, 260, 0, 28),
})

-- Gauche : or
local goldLabel = label({
	Name = "Gold",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 12, 0.4, 0),
	Size = UDim2.new(0, 190, 0, 46),
	TextColor3 = GOLD_COLOR,
	TextXAlignment = Enum.TextXAlignment.Left,
})
local incomeLabel = label({
	Name = "Income",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 12, 0.4, 40),
	Size = UDim2.new(0, 150, 0, 28),
	TextXAlignment = Enum.TextXAlignment.Left,
})

-- Bas : œuf porté + bouton vitesse
local carryLabel = label({
	Name = "Carry",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -82),
	Size = UDim2.new(0, 420, 0, 34),
	Visible = false,
})

local speedButton = Instance.new("TextButton")
speedButton.Name = "SpeedButton"
speedButton.AnchorPoint = Vector2.new(0.5, 1)
speedButton.Position = UDim2.new(0.5, 0, 1, -24)
speedButton.Size = UDim2.new(0, 300, 0, 50)
speedButton.BackgroundColor3 = Color3.fromRGB(60, 170, 255)
speedButton.Font = FONT
speedButton.TextColor3 = TEXT_COLOR
speedButton.TextScaled = true
speedButton.AutoButtonColor = true
round(speedButton)
speedButton.Parent = gui
speedButton.Activated:Connect(function()
	Remotes.UpgradeSpeed:FireServer()
end)

-- Notifications (à droite)
local toastList = Instance.new("Frame")
toastList.Name = "Toasts"
toastList.AnchorPoint = Vector2.new(1, 0)
toastList.Position = UDim2.new(1, -12, 0, 90)
toastList.Size = UDim2.new(0, 340, 0.6, 0)
toastList.BackgroundTransparency = 1
toastList.Parent = gui
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = toastList

local toastCount = 0
local function toast(text)
	toastCount += 1
	local t = label({
		Parent = toastList,
		LayoutOrder = toastCount,
		Size = UDim2.new(1, 0, 0, 40),
		Text = text,
		TextTransparency = 1,
		BackgroundTransparency = 1,
	})
	TweenService:Create(t, TweenInfo.new(0.25), { TextTransparency = 0, BackgroundTransparency = 0.25 }):Play()
	task.delay(4.5, function()
		local out = TweenService:Create(t, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 })
		out:Play()
		out.Completed:Wait()
		t:Destroy()
	end)
end
Remotes.Notify.OnClientEvent:Connect(toast)

-- Animation d'éclosion
local function showHatch(eggId, mutationName)
	local egg = Eggs.ById[eggId]
	if not egg then
		return
	end
	local rarity = Eggs.Rarities[egg.Rarity]
	local mutation = Config.GetMutation(mutationName)

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.new(0.5, 0, 0.45, 0)
	frame.Size = UDim2.new(0, 0, 0, 0)
	frame.BackgroundColor3 = PANEL_COLOR
	frame.BackgroundTransparency = 0.1
	round(frame, 20)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = rarity.Color
	stroke.Parent = frame
	frame.Parent = gui

	local title = label({
		Parent = frame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0.08, 0),
		Size = UDim2.new(1, 0, 0.4, 0),
		Text = "🥚",
	})
	local subtitle = label({
		Parent = frame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0.55, 0),
		Size = UDim2.new(1, 0, 0.3, 0),
		Text = "...",
	})

	TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.new(0, 380, 0, 200) }):Play()

	-- Suspense : l'œuf tremble
	for i = 1, 8 do
		title.Rotation = if i % 2 == 0 then 12 else -12
		task.wait(0.12)
	end
	title.Rotation = 0

	local name = egg.DragonName
	if mutation then
		name = string.format('<font color="#%s">%s</font> %s', mutation.Color:ToHex(), mutation.Name, name)
	end
	title.Text = name
	subtitle.Text = string.format('<font color="#%s">%s</font>', rarity.Color:ToHex(), rarity.Label)
	title.Size = UDim2.new(1, 0, 0.3, 0)
	title.Position = UDim2.new(0, 0, 0.15, 0)

	task.wait(3)
	local out = TweenService:Create(frame, TweenInfo.new(0.25), { Size = UDim2.new(0, 0, 0, 0) })
	out:Play()
	out.Completed:Wait()
	frame:Destroy()
end
Remotes.HatchReveal.OnClientEvent:Connect(function(eggId, mutationName)
	task.spawn(showHatch, eggId, mutationName)
end)

-- Affichage des prompts selon le joueur (propriétaire / visiteur)
local function refreshPrompt(prompt)
	local active = prompt:GetAttribute("Active") ~= false
	local audience = prompt:GetAttribute("Audience") or "All"
	local isOwner = prompt:GetAttribute("OwnerUserId") == player.UserId
	prompt.Enabled = active
		and (audience == "All" or (audience == "Owner" and isOwner) or (audience == "Others" and not isOwner))
end
local function watchPrompt(prompt)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	refreshPrompt(prompt)
	prompt.AttributeChanged:Connect(function()
		refreshPrompt(prompt)
	end)
end
CollectionService:GetInstanceAddedSignal("DHPrompt"):Connect(watchPrompt)
for _, prompt in CollectionService:GetTagged("DHPrompt") do
	watchPrompt(prompt)
end

-- Mises à jour
local function refreshStats()
	goldLabel.Text = "💰 " .. Format.Number(player:GetAttribute("Gold") or 0)
	incomeLabel.Text = "+" .. Format.Number(player:GetAttribute("IncomePerSecond") or 0) .. " /s"

	local level = player:GetAttribute("SpeedLevel") or 0
	if level >= Config.MaxSpeedLevel then
		speedButton.Text = "⚡ Vitesse MAX"
	else
		speedButton.Text = string.format("⚡ Vitesse Nv.%d → %d  (💰 %s)", level, level + 1, Format.Number(Config.SpeedCost(level)))
	end

	local carrying = player:GetAttribute("CarryingEgg")
	carryLabel.Visible = carrying ~= nil
	if carrying then
		carryLabel.Text = "🥚 " .. carrying .. " — ramène-le dans ta base !"
	end
end
player.AttributeChanged:Connect(refreshStats)
refreshStats()

local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
	accumulator += dt
	if accumulator < 0.2 then
		return
	end
	accumulator = 0

	local now = workspace:GetServerTimeNow()
	local isNight = ReplicatedStorage:GetAttribute("IsNight")
	local phaseLeft = (ReplicatedStorage:GetAttribute("PhaseEndsAt") or now) - now
	if isNight then
		phaseLabel.Text = string.format("🌙 NUIT — Éclosion x%d ! (%s)", Config.HatchSpeed.OnlineNight, Format.Time(phaseLeft))
		phaseLabel.TextColor3 = NIGHT_COLOR
	else
		phaseLabel.Text = "☀️ Jour — la nuit tombe dans " .. Format.Time(phaseLeft)
		phaseLabel.TextColor3 = DAY_COLOR
	end

	local nestLeft = (ReplicatedStorage:GetAttribute("EggRespawnAt") or now) - now
	nestLabel.Text = "🥚 Nouveaux œufs dans " .. Format.Time(nestLeft)
end)
